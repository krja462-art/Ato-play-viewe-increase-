{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with coin balance and check-in streak",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User Firebase UID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Google email" },
        "avatar": { "type": "string", "description": "Profile picture URL" },
        "coins": { "type": "number", "description": "Current coins balance" },
        "streak": { "type": "number", "description": "Consecutive check-in streak" },
        "lastCheckIn": { "type": "string", "description": "ISO date of last check-in" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "atoPlayUsername": { "type": "string", "description": "User AtoPlay channel name or username" },
        "warningCount": { "type": "number", "description": "Number of confirmed fake follow reports" },
        "isFollowRestricted": { "type": "boolean", "description": "Whether user is restricted from follow bonuses" }
      },
      "required": ["id", "email", "coins"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Video promotion campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Campaign ID" },
        "userId": { "type": "string", "description": "Creator user UID" },
        "userName": { "type": "string", "description": "Creator user name" },
        "videoUrl": { "type": "string", "description": "AtoPlay / YouTube video link" },
        "title": { "type": "string", "description": "Video title" },
        "thumbnailUrl": { "type": "string", "description": "Video thumbnail URL" },
        "targetViews": { "type": "number", "description": "Total target views" },
        "completedViews": { "type": "number", "description": "Views completed so far" },
        "viewsRequired": { "type": "number", "description": "Total views required for campaign" },
        "viewsCompleted": { "type": "number", "description": "Views completed by watchers" },
        "rewardPerView": { "type": "number", "description": "Coins awarded to viewer (60 coins)" },
        "durationSeconds": { "type": "number", "description": "Watch timer duration" },
        "totalCoinsCost": { "type": "number", "description": "Coins spent on campaign" },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled"] },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "displayId": { "type": "string", "description": "Public video ID" },
        "completedUserIds": { 
          "type": "array", 
          "items": { "type": "string" }, 
          "description": "List of user UIDs who have completed this video task" 
        },
        "followedUserIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of user UIDs who have followed this creator channel for 30 coins"
        },
        "channelFollowers": {
          "type": "number",
          "description": "Latest follower count fetched from AtoPlay API"
        }
      },
      "required": ["id", "userId", "videoUrl", "targetViews", "completedViews", "status"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "User support inquiries and messages sent to admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message document ID" },
        "userId": { "type": "string", "description": "Sender user UID" },
        "userName": { "type": "string", "description": "Sender user name" },
        "userEmail": { "type": "string", "description": "Sender email address" },
        "targetEmail": { "type": "string", "description": "Destination admin recipient email (krja462@gmail.com)" },
        "subject": { "type": "string", "description": "Message topic or subject" },
        "message": { "type": "string", "description": "Full message content" },
        "createdAt": { "type": "string", "description": "Timestamp when message was submitted" }
      },
      "required": ["userId", "targetEmail", "message", "createdAt"]
    },
    "FollowLog": {
      "title": "FollowLog",
      "description": "Log of users claiming follow bonus rewards on creator channels",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log ID" },
        "campaignId": { "type": "string", "description": "ID of the target campaign" },
        "creatorId": { "type": "string", "description": "UID of the campaign creator" },
        "followerUserId": { "type": "string", "description": "UID of the user who followed" },
        "followerUsername": { "type": "string", "description": "User AtoPlay username" },
        "timestamp": { "type": "string", "description": "Action timestamp" },
        "status": { "type": "string", "enum": ["active", "reported"], "description": "Log status" },
        "campaignTitle": { "type": "string", "description": "Campaign title" },
        "reportedAt": { "type": "string", "description": "Timestamp when reported as fake" }
      },
      "required": ["id", "campaignId", "creatorId", "followerUserId", "followerUsername", "timestamp", "status"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Warning and system notifications delivered to users (e.g. fake follow report warnings)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "userId": { "type": "string", "description": "Target user UID" },
        "userEmail": { "type": "string", "description": "Target user email" },
        "type": { "type": "string", "description": "Notification type" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification message body" },
        "notice": { "type": "string", "description": "Policy warning notice" },
        "channelUrl": { "type": "string", "description": "Channel URL to follow" },
        "channelTitle": { "type": "string", "description": "Channel title" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "read": { "type": "boolean", "description": "Whether the user acknowledged the notification" }
      },
      "required": ["userId", "type", "title", "message", "timestamp", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles keyed by Firebase Auth UID"
    },
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Stores active and completed video campaigns"
    },
    "/follow_logs/{logId}": {
      "schema": "FollowLog",
      "description": "Logs of claimed follow rewards for creator transparency and fake follow reporting"
    },
    "/support_messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Stores customer support inquiries sent to krja462@gmail.com"
    },
    "/user_notifications/{notifId}": {
      "schema": "UserNotification",
      "description": "Stores warning notifications for reported users"
    }
  }
}
